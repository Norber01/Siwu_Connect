rules_version = '2';

// Siwu Connect — Firestore security rules (Phase 1).
//
// Principles:
//  * Every read needs a signed-in user (decision D3).
//  * Clients may only write their own profile, posts, comments, reactions,
//    reports and blocks — always validated here, on the server.
//  * Privileged actions (roles, suspensions, removing other people's content,
//    resolving reports, announcements, pins) are NEVER client-writable. They go
//    through the Cloudflare Worker API, which uses admin credentials and writes
//    an audit-log entry for each action.
//  * Limits below mirror packages/shared/src/constants.ts — keep them in sync.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function d() { return request.resource.data; }
    function isTown(t) { return t in ['odomi', 'mempeasem', 'todzi', 'adokor', 'sokpo']; }
    function exactKeys(keys) {
      return request.resource.data.keys().hasAll(keys) && request.resource.data.keys().hasOnly(keys);
    }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }

    function userPath(uid) { return /databases/$(database)/documents/users/$(uid); }
    function isActive() {
      return signedIn() && exists(userPath(me())) && get(userPath(me())).data.status == 'active';
    }

    function rolePath() { return /databases/$(database)/documents/admin_roles/$(me()); }
    function hasRole() { return signedIn() && exists(rolePath()); }
    function isSuper() { return hasRole() && get(rolePath()).data.role == 'super_admin'; }
    function canModerate(townId) {
      return hasRole()
        && (get(rolePath()).data.role == 'super_admin'
            || (get(rolePath()).data.role in ['town_admin', 'moderator'] && townId in get(rolePath()).data.townIds));
    }
    // Sports reporters and every admin role may manage matches.
    function canReportSports() { return hasRole(); }
    function imageOk(url, uid) {
      return url == null
        || (str(url, 10, 300)
            && url.matches('^https?://[^/]+(/[^/]+)*/images/' + uid + '/[A-Za-z0-9_-]+[.](webp|jpg)$'));
    }

    function ratePath() { return /databases/$(database)/documents/rate_limits/$(me()); }
    // The same batch must stamp rate_limits/{me}.{field} with request.time, and the
    // previous stamp (if any) must be older than `secs` seconds.
    function rateOk(field, secs) {
      return getAfter(ratePath()).data.get(field, null) == request.time
        && (!exists(ratePath())
            || get(ratePath()).data.get(field, null) == null
            || get(ratePath()).data.get(field, null) < request.time - duration.value(secs, 's'));
    }

    // ---------- towns & settings (read-only for clients) ----------
    match /towns/{townId} {
      allow read: if true;
      allow write: if false;
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ---------- usernames: guarantees uniqueness ----------
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn()
        && exactKeys(['uid'])
        && d().uid == me()
        && name.matches('^[a-z0-9_]{3,20}$')
        && !(name in ['admin', 'administrator', 'siwu', 'siwuconnect', 'siwu_connect', 'moderator',
                      'support', 'official', 'akpafu', 'superadmin', 'super_admin', 'help'])
        && !exists(userPath(me()))
        && getAfter(userPath(me())).data.username == name;
      allow update, delete: if false;
    }

    // ---------- public profiles ----------
    function validProfile(p, uid) {
      return str(p.displayName, 2, 50)
        && p.displayNameLower == p.displayName.lower()
        && isTown(p.hometownId)
        && (p.residence == null || p.residence in ['hometown', 'ghana', 'abroad'])
        && (p.countryCode == null || str(p.countryCode, 2, 5))
        && (p.photoUrl == null
            || (str(p.photoUrl, 10, 300)
                && p.photoUrl.matches('^https?://[^/]+(/[^/]+)*/avatars/' + uid + '/[A-Za-z0-9_-]+[.](webp|jpg)$')));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == me()
        && exactKeys(['displayName', 'displayNameLower', 'username', 'photoUrl', 'hometownId',
                      'residence', 'countryCode', 'status', 'createdAt', 'updatedAt'])
        && validProfile(d(), uid)
        && d().username is string
        && getAfter(/databases/$(database)/documents/usernames/$(d().username)).data.uid == uid
        && d().status == 'active'
        && d().createdAt == request.time
        && d().updatedAt == request.time;
      // Username, status and createdAt are immutable from the client.
      allow update: if isActive() && uid == me()
        && changed().hasOnly(['displayName', 'displayNameLower', 'photoUrl', 'hometownId',
                              'residence', 'countryCode', 'updatedAt'])
        && validProfile(d(), uid)
        && d().updatedAt == request.time;
      allow delete: if false;

      // Users this user has blocked. Private to the owner.
      match /blocks/{blockedUid} {
        allow read, delete: if signedIn() && uid == me();
        allow create: if signedIn() && uid == me() && blockedUid != me()
          && exactKeys(['createdAt']) && d().createdAt == request.time;
        allow update: if false;
      }
    }

    // ---------- private account fields ----------
    match /users_private/{uid} {
      allow read: if signedIn() && (uid == me() || isSuper());
      allow create: if signedIn() && uid == me()
        && exactKeys(['rulesAcceptedAt', 'ageConfirmedAt', 'createdAt'])
        && d().rulesAcceptedAt == request.time
        && d().ageConfirmedAt == request.time
        && d().createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- per-user rate-limit stamps ----------
    match /rate_limits/{uid} {
      allow read: if signedIn() && uid == me();
      allow create: if signedIn() && uid == me()
        && d().keys().hasOnly(['lastPostAt', 'lastCommentAt', 'lastEventAt', 'lastListingAt'])
        && d().get('lastPostAt', request.time) == request.time
        && d().get('lastCommentAt', request.time) == request.time
        && d().get('lastEventAt', request.time) == request.time
        && d().get('lastListingAt', request.time) == request.time;
      allow update: if signedIn() && uid == me()
        && d().keys().hasOnly(['lastPostAt', 'lastCommentAt', 'lastEventAt', 'lastListingAt'])
        && (!('lastPostAt' in changed()) || d().lastPostAt == request.time)
        && (!('lastCommentAt' in changed()) || d().lastCommentAt == request.time)
        && (!('lastEventAt' in changed()) || d().lastEventAt == request.time)
        && (!('lastListingAt' in changed()) || d().lastListingAt == request.time);
      allow delete: if false;
    }

    // ---------- posts ----------
    function postPath(id) { return /databases/$(database)/documents/posts/$(id); }
    function reactionPath(postId, uid) { return /databases/$(database)/documents/posts/$(postId)/reactions/$(uid); }
    function commentPath(postId, cid) { return /databases/$(database)/documents/posts/$(postId)/comments/$(cid); }

    // Photos and videos on posts: up to 4, each one uploaded by the author.
    function videoOk(url, uid) {
      return str(url, 10, 300)
        && url.matches('^https?://[^/]+(/[^/]+)*/videos/' + uid + '/[A-Za-z0-9_-]+[.](mp4|mov|webm)$');
    }
    function mediaItemOk(i, uid) {
      return i is map && i.keys().hasOnly(['type', 'url', 'posterUrl'])
        && ((i.type == 'image' && i.url != null && imageOk(i.url, uid))
            || (i.type == 'video' && videoOk(i.url, uid)))
        && imageOk(i.get('posterUrl', null), uid);
    }
    function mediaOk(m, uid) {
      return m is list && m.size() <= 4
        && (m.size() < 1 || mediaItemOk(m[0], uid))
        && (m.size() < 2 || mediaItemOk(m[1], uid))
        && (m.size() < 3 || mediaItemOk(m[2], uid))
        && (m.size() < 4 || mediaItemOk(m[3], uid));
    }
    // A post needs text, photos/videos, or both.
    function postBodyOk(p) {
      return str(p.text, 0, 2000)
        && imageOk(p.get('imageUrl', null), me())
        && mediaOk(p.get('media', []), me())
        && (p.text.size() > 0 || p.get('imageUrl', null) != null || p.get('media', []).size() > 0);
    }

    match /posts/{postId} {
      allow read: if signedIn()
        && (resource.data.status == 'published'
            || resource.data.authorId == me()
            || canModerate(resource.data.townId));

      allow create: if isActive()
        && exactKeys(['authorId', 'townId', 'text', 'imageUrl', 'media', 'visibility', 'status', 'pinned', 'reactionCount',
                      'commentCount', 'lastCommentOp', 'searchTokens', 'createdAt', 'updatedAt', 'editedAt'])
        && d().authorId == me()
        && isTown(d().townId)
        && postBodyOk(d())
        && d().visibility in ['akpafu', 'town']
        && d().status == 'published'
        && d().pinned == false
        && d().reactionCount == 0
        && d().commentCount == 0
        && d().lastCommentOp == null
        && d().searchTokens is list && d().searchTokens.size() <= 50
        && d().createdAt == request.time
        && d().updatedAt == request.time
        && d().editedAt == null
        && rateOk('lastPostAt', 20);

      allow update: if
        // 1. Author edits their own published post.
        (isActive() && resource.data.authorId == me() && resource.data.status == 'published'
          && changed().hasOnly(['text', 'imageUrl', 'media', 'searchTokens', 'visibility', 'updatedAt', 'editedAt'])
          && postBodyOk(d())
          && d().visibility in ['akpafu', 'town']
          && d().searchTokens is list && d().searchTokens.size() <= 50
          && d().updatedAt == request.time
          && d().editedAt == request.time)
        // 2. Author deletes their own post (soft delete; text is wiped).
        || (signedIn() && resource.data.authorId == me() && resource.data.status in ['published', 'removed']
          && changed().hasOnly(['status', 'text', 'imageUrl', 'media', 'searchTokens', 'updatedAt'])
          && d().status == 'deleted' && d().text == '' && d().get('imageUrl', null) == null
          && d().get('media', []).size() == 0 && d().searchTokens.size() == 0
          && d().updatedAt == request.time)
        // 3. Reaction counter moves by exactly one, together with the caller's reaction doc.
        || (signedIn() && resource.data.status == 'published'
          && changed().hasOnly(['reactionCount'])
          && ((d().reactionCount == resource.data.reactionCount + 1
                && !exists(reactionPath(postId, me())) && existsAfter(reactionPath(postId, me())))
              || (d().reactionCount == resource.data.reactionCount - 1
                && exists(reactionPath(postId, me())) && !existsAfter(reactionPath(postId, me())))))
        // 4. Comment counter moves by exactly one, together with the named comment.
        || (signedIn() && resource.data.status == 'published'
          && changed().hasOnly(['commentCount', 'lastCommentOp'])
          && d().lastCommentOp.keys().hasOnly(['id', 'op'])
          && ((d().lastCommentOp.op == 'add'
                && d().commentCount == resource.data.commentCount + 1
                && !exists(commentPath(postId, d().lastCommentOp.id))
                && existsAfter(commentPath(postId, d().lastCommentOp.id)))
              || (d().lastCommentOp.op == 'remove'
                && d().commentCount == resource.data.commentCount - 1
                && get(commentPath(postId, d().lastCommentOp.id)).data.status == 'published'
                && getAfter(commentPath(postId, d().lastCommentOp.id)).data.status == 'deleted')));

      allow delete: if false;

      // One reaction per user per post: the document id is the user's uid.
      match /reactions/{rid} {
        allow read: if signedIn();
        allow create: if isActive() && rid == me()
          && exactKeys(['type', 'userId', 'postId', 'createdAt'])
          && d().type == 'like'
          && d().userId == me()
          && d().postId == postId
          && d().createdAt == request.time
          && get(postPath(postId)).data.status == 'published'
          && getAfter(postPath(postId)).data.reactionCount == get(postPath(postId)).data.reactionCount + 1;
        allow delete: if signedIn() && rid == me()
          && getAfter(postPath(postId)).data.reactionCount == get(postPath(postId)).data.reactionCount - 1;
        allow update: if false;
      }

      match /comments/{cid} {
        allow read: if signedIn()
          && (resource.data.status == 'published'
              || resource.data.authorId == me()
              || canModerate(resource.data.townId));

        allow create: if isActive()
          && exactKeys(['authorId', 'townId', 'text', 'status', 'createdAt'])
          && d().authorId == me()
          && d().townId == get(postPath(postId)).data.townId
          && str(d().text, 1, 1000)
          && d().status == 'published'
          && d().createdAt == request.time
          && get(postPath(postId)).data.status == 'published'
          // Users blocked by the post author cannot comment on that author's posts.
          && !exists(/databases/$(database)/documents/users/$(get(postPath(postId)).data.authorId)/blocks/$(me()))
          && getAfter(postPath(postId)).data.commentCount == get(postPath(postId)).data.commentCount + 1
          && getAfter(postPath(postId)).data.lastCommentOp == {'id': cid, 'op': 'add'}
          && rateOk('lastCommentAt', 5);

        // Author deletes their own comment (soft delete). If the post is still
        // published the counter must go down in the same batch.
        allow update: if signedIn() && resource.data.authorId == me()
          && resource.data.status == 'published'
          && changed().hasOnly(['status', 'text'])
          && d().status == 'deleted' && d().text == ''
          && (get(postPath(postId)).data.status != 'published'
              || (getAfter(postPath(postId)).data.commentCount == get(postPath(postId)).data.commentCount - 1
                  && getAfter(postPath(postId)).data.lastCommentOp == {'id': cid, 'op': 'remove'}));

        allow delete: if false;
      }
    }

    // Lets a user find their own reactions across posts (one query per feed page).
    match /{path=**}/reactions/{rid} {
      allow read: if signedIn() && resource.data.userId == me();
    }

    // ---------- notifications (written by the person who liked/commented) ----------
    function notifOk(uid, nid) {
      return signedIn() && uid != me()
        && exactKeys(['type', 'actorId', 'postId', 'commentId', 'read', 'createdAt'])
        && d().actorId == me()
        && d().read == false
        && d().createdAt == request.time
        && get(postPath(d().postId)).data.authorId == uid
        && ((d().type == 'like' && nid == 'like_' + d().postId + '_' + me() && d().commentId == null
              && existsAfter(reactionPath(d().postId, me())))
            || (d().type == 'comment' && nid == 'comment_' + d().commentId
              && !exists(commentPath(d().postId, d().commentId))
              && getAfter(commentPath(d().postId, d().commentId)).data.authorId == me()));
    }
    match /users/{uid}/notifications/{nid} {
      allow read, delete: if signedIn() && uid == me();
      allow create: if notifOk(uid, nid);
      allow update: if (signedIn() && uid == me() && changed().hasOnly(['read']) && d().read == true)
        || notifOk(uid, nid);
    }

    // ---------- events ----------
    function eventPath(id) { return /databases/$(database)/documents/events/$(id); }
    function rsvpPath(eid) { return /databases/$(database)/documents/events/$(eid)/rsvps/$(me()); }
    function rsvpBefore(eid) { return exists(rsvpPath(eid)) ? get(rsvpPath(eid)).data.status : 'none'; }
    function rsvpAfter(eid) { return existsAfter(rsvpPath(eid)) ? getAfter(rsvpPath(eid)).data.status : 'none'; }
    function delta(status, b, a) { return (a == status ? 1 : 0) - (b == status ? 1 : 0); }
    function rsvpCountersOk(eid, before, after) {
      return rsvpBefore(eid) != rsvpAfter(eid)
        && after.goingCount == before.goingCount + delta('going', rsvpBefore(eid), rsvpAfter(eid))
        && after.interestedCount == before.interestedCount + delta('interested', rsvpBefore(eid), rsvpAfter(eid));
    }
    function validEvent(e, uid) {
      return isTown(e.townId)
        && str(e.title, 3, 120)
        && str(e.description, 0, 2000)
        && e.category in ['festival', 'funeral', 'wedding', 'church', 'meeting', 'sports', 'community', 'other']
        && str(e.location, 0, 200)
        && e.startsAt is timestamp
        && (e.endsAt == null || (e.endsAt is timestamp && e.endsAt > e.startsAt))
        && imageOk(e.imageUrl, uid);
    }

    match /events/{eventId} {
      allow read: if signedIn()
        && (resource.data.status in ['published', 'cancelled']
            || resource.data.authorId == me()
            || canModerate(resource.data.townId));
      allow create: if isActive()
        && exactKeys(['authorId', 'townId', 'title', 'description', 'category', 'location', 'startsAt', 'endsAt',
                      'imageUrl', 'status', 'goingCount', 'interestedCount', 'createdAt', 'updatedAt'])
        && d().authorId == me()
        && validEvent(d(), me())
        && d().status == 'published'
        && d().goingCount == 0 && d().interestedCount == 0
        && d().createdAt == request.time && d().updatedAt == request.time
        && rateOk('lastEventAt', 60);
      allow update: if
        (isActive() && resource.data.authorId == me() && resource.data.status == 'published'
          && changed().hasOnly(['townId', 'title', 'description', 'category', 'location', 'startsAt', 'endsAt',
                                'imageUrl', 'updatedAt'])
          && validEvent(d(), me()) && d().updatedAt == request.time)
        || (signedIn() && resource.data.authorId == me()
          && changed().hasOnly(['status', 'updatedAt']) && d().updatedAt == request.time
          && ((resource.data.status == 'published' && d().status == 'cancelled')
              || (resource.data.status != 'deleted' && d().status == 'deleted')))
        || (signedIn() && resource.data.status == 'published'
          && changed().hasOnly(['goingCount', 'interestedCount'])
          && rsvpCountersOk(eventId, resource.data, d()));
      allow delete: if false;

      match /rsvps/{rid} {
        allow read: if signedIn() && rid == me();
        allow create, update: if isActive() && rid == me()
          && exactKeys(['status', 'userId', 'eventId', 'createdAt'])
          && d().status in ['going', 'interested']
          && d().userId == me() && d().eventId == eventId
          && d().createdAt is timestamp
          && get(eventPath(eventId)).data.status == 'published'
          && rsvpCountersOk(eventId, get(eventPath(eventId)).data, getAfter(eventPath(eventId)).data);
        allow delete: if signedIn() && rid == me()
          && (get(eventPath(eventId)).data.status != 'published'
              || rsvpCountersOk(eventId, get(eventPath(eventId)).data, getAfter(eventPath(eventId)).data));
      }
    }
    match /{path=**}/rsvps/{rid} {
      allow read: if signedIn() && resource.data.userId == me();
    }

    // ---------- marketplace ----------
    function validListing(l, uid) {
      return isTown(l.townId)
        && str(l.title, 3, 100)
        && str(l.description, 0, 1500)
        && l.category in ['food', 'clothing', 'electronics', 'household', 'services', 'vehicles', 'property', 'other']
        && (l.price == null || (l.price is int && l.price >= 0 && l.price <= 10000000))
        && str(l.priceUnit, 0, 30)
        && imageOk(l.imageUrl, uid)
        && (l.contactPhone == null || (l.contactPhone is string && l.contactPhone.matches('^[+]?[0-9]{9,15}$')))
        && l.contactWhatsApp is bool
        && l.searchTokens is list && l.searchTokens.size() <= 50;
    }

    match /listings/{listingId} {
      allow read: if signedIn()
        && (resource.data.status in ['available', 'sold']
            || resource.data.sellerId == me()
            || canModerate(resource.data.townId));
      allow create: if isActive()
        && exactKeys(['sellerId', 'townId', 'title', 'description', 'category', 'price', 'priceUnit', 'imageUrl',
                      'contactPhone', 'contactWhatsApp', 'status', 'searchTokens', 'createdAt', 'updatedAt'])
        && d().sellerId == me()
        && validListing(d(), me())
        && d().status == 'available'
        && d().createdAt == request.time && d().updatedAt == request.time
        && rateOk('lastListingAt', 60);
      allow update: if
        (isActive() && resource.data.sellerId == me() && resource.data.status in ['available', 'sold']
          && changed().hasOnly(['townId', 'title', 'description', 'category', 'price', 'priceUnit', 'imageUrl',
                                'contactPhone', 'contactWhatsApp', 'status', 'searchTokens', 'updatedAt'])
          && d().status in ['available', 'sold']
          && validListing(d(), me()) && d().updatedAt == request.time)
        || (signedIn() && resource.data.sellerId == me() && resource.data.status != 'deleted'
          && changed().hasOnly(['status', 'updatedAt']) && d().status == 'deleted' && d().updatedAt == request.time);
      allow delete: if false;
    }

    // ---------- sports centre ----------
    function matchPath(id) { return /databases/$(database)/documents/matches/$(id); }
    function votePath(mid) { return /databases/$(database)/documents/matches/$(mid)/votes/$(me()); }
    function validTeam(t) {
      return t.keys().hasOnly(['name', 'townId']) && str(t.name, 2, 50) && (t.townId == null || isTown(t.townId));
    }
    function validMatch(m) {
      return str(m.competition, 3, 80)
        && validTeam(m.home) && validTeam(m.away)
        && str(m.venue, 0, 200)
        && m.kickoffAt is timestamp
        && m.status in ['scheduled', 'live', 'halftime', 'finished', 'postponed', 'cancelled']
        && m.homeScore is int && m.homeScore >= 0 && m.homeScore <= 99
        && m.awayScore is int && m.awayScore >= 0 && m.awayScore <= 99
        && (m.minute == null || (m.minute is int && m.minute >= 0 && m.minute <= 130))
        && m.durationMinutes is int && m.durationMinutes >= 10 && m.durationMinutes <= 150
        && m.breakMinutes is int && m.breakMinutes >= 0 && m.breakMinutes <= 60
        && (m.actualKickoffAt == null || m.actualKickoffAt is timestamp)
        && (m.secondHalfStartAt == null || m.secondHalfStartAt is timestamp);
    }
    function votingOpen(m) { return m.status in ['scheduled', 'live', 'halftime']; }
    function voteCountersOk(before, after, pick) {
      return after.votesHome == before.votesHome + (pick == 'home' ? 1 : 0)
        && after.votesDraw == before.votesDraw + (pick == 'draw' ? 1 : 0)
        && after.votesAway == before.votesAway + (pick == 'away' ? 1 : 0);
    }

    match /matches/{matchId} {
      allow read: if signedIn();
      allow create: if canReportSports()
        && exactKeys(['competition', 'home', 'away', 'venue', 'kickoffAt', 'durationMinutes', 'breakMinutes',
                      'actualKickoffAt', 'secondHalfStartAt', 'status', 'homeScore', 'awayScore', 'minute',
                      'votesHome', 'votesDraw', 'votesAway', 'createdBy', 'createdAt', 'updatedAt'])
        && d().actualKickoffAt == null && d().secondHalfStartAt == null
        && validMatch(d())
        && d().status == 'scheduled' && d().homeScore == 0 && d().awayScore == 0 && d().minute == null
        && d().votesHome == 0 && d().votesDraw == 0 && d().votesAway == 0
        && d().createdBy == me()
        && d().createdAt == request.time && d().updatedAt == request.time;
      allow update: if
        (canReportSports()
          && changed().hasOnly(['competition', 'home', 'away', 'venue', 'kickoffAt', 'durationMinutes', 'breakMinutes',
                                'actualKickoffAt', 'secondHalfStartAt', 'status', 'homeScore', 'awayScore',
                                'minute', 'updatedAt'])
          && validMatch(d()) && d().updatedAt == request.time)
        || (signedIn() && votingOpen(resource.data)
          && changed().hasOnly(['votesHome', 'votesDraw', 'votesAway'])
          && !exists(votePath(matchId)) && existsAfter(votePath(matchId))
          && voteCountersOk(resource.data, d(), getAfter(votePath(matchId)).data.pick));
      allow delete: if canReportSports();

      match /updates/{updateId} {
        allow read: if signedIn();
        allow create: if canReportSports()
          && exactKeys(['type', 'team', 'minute', 'text', 'createdBy', 'createdAt'])
          && d().type in ['goal', 'yellow', 'red', 'sub', 'chance', 'note']
          && (d().team == null || d().team in ['home', 'away'])
          && (d().minute == null || (d().minute is int && d().minute >= 0 && d().minute <= 130))
          && str(d().text, 0, 200)
          && d().createdBy == me() && d().createdAt == request.time;
        allow delete: if canReportSports();
        allow update: if false;
      }

      // One free prediction per member per match (no money involved).
      match /votes/{rid} {
        allow read: if signedIn() && rid == me();
        allow create: if isActive() && rid == me()
          && exactKeys(['pick', 'userId', 'matchId', 'createdAt'])
          && d().pick in ['home', 'draw', 'away']
          && d().userId == me() && d().matchId == matchId
          && d().createdAt == request.time
          && votingOpen(get(matchPath(matchId)).data)
          && voteCountersOk(get(matchPath(matchId)).data, getAfter(matchPath(matchId)).data, d().pick);
        allow update, delete: if false;
      }
    }

    // ---------- tester feedback ----------
    match /feedback/{id} {
      allow create: if signedIn()
        && exactKeys(['userId', 'text', 'page', 'createdAt'])
        && d().userId == me()
        && str(d().text, 3, 2000)
        && str(d().page, 0, 200)
        && d().createdAt == request.time;
      allow read: if isSuper();
      allow update, delete: if false;
    }

    // ---------- reports ----------
    match /reports/{reportId} {
      // Report id = <reporter>_<type>_<targetId>, so a user can report an item once.
      allow create: if isActive()
        && exactKeys(['reporterId', 'targetType', 'targetId', 'targetPath', 'townId', 'reason', 'details',
                      'status', 'createdAt', 'resolvedBy', 'resolvedAt', 'resolution'])
        && d().reporterId == me()
        && d().targetType in ['post', 'comment', 'user', 'event', 'listing']
        && str(d().targetId, 1, 128)
        && reportId == me() + '_' + d().targetType + '_' + d().targetId
        && ((d().targetType == 'post' && d().targetPath == 'posts/' + d().targetId)
            || (d().targetType == 'comment' && d().targetPath.matches('^posts/[A-Za-z0-9]+/comments/' + d().targetId + '$'))
            || (d().targetType == 'user' && d().targetPath == 'users/' + d().targetId && d().targetId != me())
            || (d().targetType == 'event' && d().targetPath == 'events/' + d().targetId)
            || (d().targetType == 'listing' && d().targetPath == 'listings/' + d().targetId))
        && isTown(d().townId)
        && d().reason in ['harassment', 'threat', 'impersonation', 'spam', 'misinformation', 'defamation', 'fraud', 'other']
        && str(d().details, 0, 500)
        && d().status == 'open'
        && d().createdAt == request.time
        && d().resolvedBy == null && d().resolvedAt == null && d().resolution == null;
      allow read: if canModerate(resource.data.townId);
      allow update, delete: if false;
    }

    // ---------- announcements (written only by the Worker) ----------
    match /announcements/{id} {
      allow read: if signedIn() && (resource.data.status == 'published' || hasRole());
      allow write: if false;
    }

    // ---------- admin roles & audit log (written only by the Worker) ----------
    match /admin_roles/{uid} {
      allow read: if signedIn() && (uid == me() || isSuper());
      allow write: if false;
    }
    match /audit_logs/{id} {
      allow read: if isSuper();
      allow write: if false;
    }
  }
}
