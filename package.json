{
  "name": "@siwu/shared",
  "private": "true",
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @siwu/web",
    "build": "npm run build -w @siwu/shared && npm run build -w @siwu/web",
    "typecheck": "tsc -p packages/shared && tsc -p apps/web --noEmit && tsc -p apps/api --noEmit && tsc -p tests --noEmit",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:emulator",
    "test:unit": "vitest run --project shared --project web",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project demo-siwu \"vitest run --project rules --project api\"",
    "test:e2e": "playwright test --trace off",
    "emulators": "firebase emulators:start --project demo-siwu --import firebase/seed-emulator --export-on-exit",
    "dev:api": "npm run dev -w @siwu/api",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.1",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "firebase": "^11.0.2",
    "firebase-tools": "^13.29.1",
    "prettier": "^3.4.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.16.0",
    "vitest": "^2.1.8"
  },
  "main": "src/index.ts",
  "types": "src/index.ts"
}
