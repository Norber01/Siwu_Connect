# Copy to .env.production.local (or set in Cloudflare Pages) with your real Firebase web config.
# These values are public by design (Firebase web config is not a secret); access is protected by security rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_API_URL=https://api.example.com
VITE_USE_EMULATORS=false
